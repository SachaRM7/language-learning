{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "helloarabic",
  "account_id": "5f896b4f6ccbd8f3ae702693ac9a2b3e",
  "main": "worker/index.js",
  "workers_dev": true,
  "preview_urls": false,
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],

  // Le frontend (public/) est embarqué dans le Worker au moment du build (scripts/embed-assets.mjs) :
  // pas d'étape d'upload d'assets séparée, déploiement en une commande.
  "build": {
    "command": "node scripts/embed-assets.mjs",
    "watch_dir": "public"
  },

  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "helloarabic",
      "database_id": "ff9f1ec9-8516-4e7d-97bc-174953af1a1a",
      "migrations_dir": "migrations"
    }
  ],

  // Cloudflare Access protège tout le domaine ; le Worker revérifie le JWT pour /api/*.
  // ACCESS_TEAM_DOMAIN : <équipe>.cloudflareaccess.com — ACCESS_AUD : « Application Audience (AUD) Tag ».
  "vars": {
    "ACCESS_TEAM_DOMAIN": "gentle-dream-6577.cloudflareaccess.com",
    "ACCESS_AUD": "f2a7791f9561484f001de1d194bdf63c564513c6e4796d6453b511d54ba0e2e1",
    "TUTOR_MODEL": "claude-opus-5-5"
  },

  // Secret à définir : npx wrangler secret put ANTHROPIC_API_KEY
  "observability": { "enabled": true }
}
