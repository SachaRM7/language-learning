{
  "name": "helloarabic",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler dev --var DEV_USER:dev@local",
    "deploy": "wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply helloarabic --local",
    "db:migrate": "wrangler d1 migrations apply helloarabic --remote",
    "test": "node scripts/embed-assets.mjs && node --test tests/quran.test.mjs tests/pedagogy.test.mjs tests/roots-search.test.mjs",
    "test:browser": "node tests/quran.browser.mjs",
    "test:motion": "node tests/motion.browser.mjs"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@tilawa/core": "1.0.0-rc.1",
    "onnxruntime-web": "1.30.0"
  },
  "devDependencies": {
    "esbuild": "0.28.2",
    "playwright": "^1.65.1",
    "wrangler": "^4.163.0"
  }
}
