{"id":64,"name":"At-Taghabun","nameAr":"التغابن","nameFr":"La grande perte","place":"madinah","verses":[{"n":1,"k":"64:1","fr":"Ce qui est dans les cieux et ce qui est sur la Terre glorifient Allah. A Lui la royauté et à Lui les louanges. Et Il est Omnipotent.","audio":"Alafasy/mp3/064001.mp3","w":[{"t":"يُسَبِّحُ","en":"Glorifies","tr":"yusabbiḥu","l":"سَبَّحَ","r":"سبح","p":"verbe","a":"wbw/064_001_001.mp3"},{"t":"لِلَّهِ","en":"[to] Allah","tr":"lillahi","l":"اللَّه","r":"أله","p":"nom propre","a":"wbw/064_001_002.mp3"},{"t":"مَا","en":"whatever","tr":"mā","l":"ما","r":null,"p":"relatif","a":"wbw/064_001_003.mp3"},{"t":"فِى","en":"(is) in","tr":"fī","l":"فِي","r":null,"p":"préposition","a":"wbw/064_001_004.mp3"},{"t":"ٱلسَّمَـٰوَٰتِ","en":"the heavens","tr":"l-samāwāti","l":"سَماء","r":"سمو","p":"nom","a":"wbw/064_001_005.mp3"},{"t":"وَمَا","en":"and whatever","tr":"wamā","l":"ما","r":null,"p":"relatif","a":"wbw/064_001_006.mp3"},{"t":"فِى","en":"(is) in","tr":"fī","l":"فِي","r":null,"p":"préposition","a":"wbw/064_001_007.mp3"},{"t":"ٱلْأَرْضِ ۖ","en":"the earth","tr":"l-arḍi","l":"أَرْض","r":"أرض","p":"nom","a":"wbw/064_001_008.mp3"},{"t":"لَهُ","en":"For Him","tr":"lahu","l":"لَهُ","r":null,"p":"pronom","a":"wbw/064_001_010.mp3"},{"t":"ٱلْمُلْكُ","en":"(is the) dominion","tr":"l-mul'ku","l":"مُلْك","r":"ملك","p":"nom","a":"wbw/064_001_011.mp3"},{"t":"وَلَهُ","en":"and for Him","tr":"walahu","l":"وَلَهُ","r":null,"p":"pronom","a":"wbw/064_001_012.mp3"},{"t":"ٱلْحَمْدُ ۖ","en":"(is) the praise","tr":"l-ḥamdu","l":"حَمْد","r":"حمد","p":"nom","a":"wbw/064_001_013.mp3"},{"t":"وَهُوَ","en":"And He","tr":"wahuwa","l":"وَهُوَ","r":null,"p":"pronom","a":"wbw/064_001_015.mp3"},{"t":"عَلَىٰ","en":"(is) on","tr":"ʿalā","l":"عَلَى","r":null,"p":"préposition","a":"wbw/064_001_016.mp3"},{"t":"كُلِّ","en":"every","tr":"kulli","l":"كُلّ","r":"كلل","p":"nom","a":"wbw/064_001_017.mp3"},{"t":"شَىْءٍۢ","en":"thing","tr":"shayin","l":"شَىْء","r":"شيأ","p":"nom","a":"wbw/064_001_018.