,"r":null,"p":"interrogatif","a":"wbw/063_004_028.mp3"},{"t":"يُؤْفَكُونَ","en":"are they deluded","tr":"yu'fakūna","l":"أُفِكَ","r":"أفك","p":"verbe","a":"wbw/063_004_029.mp3"}]},{"n":5,"k":"63:5","fr":"Et quand on leur dit : \"Venez que le Messager d’Allah implore le pardon pour vous\", ils détournent leurs têtes, et tu les vois se détourner tandis qu’ils s’enflent d’orgueil.","audio":"Alafasy/mp3/063005.mp3","w":[{"t":"وَإِذَا","en":"And when","tr":"wa-idhā","l":"إِذا","r":null,"p":"temps","a":"wbw/063_005_001.mp3"},{"t":"قِيلَ","en":"it is said","tr":"qīla","l":"قالَ","r":"قول","p":"verbe","a":"wbw/063_005_002.mp3"},{"t":"لَهُمْ","en":"to them","tr":"lahum","l":"لَهُمْ","r":null,"p":"pronom","a":"wbw/063_005_003.mp3"},{"t":"تَعَالَوْا۟","en":"Come","tr":"taʿālaw","l":"تَعالَ","r":"علو","p":"verbe","a":"wbw/063_005_004.mp3"},{"t":"يَسْتَغْفِرْ","en":"will ask forgiveness","tr":"yastaghfir","l":"اسْتَغْفَرَ","r":"غفر","p":"verbe","a":"wbw/063_005_005.mp3"},{"t":"لَكُمْ","en":"for you","tr":"lakum","l":"لَكُمْ","r":null,"p":"pronom","a":"wbw/063_005_006.mp3"},{"t":"رَسُولُ","en":"(the) Messenger","tr":"rasūlu","l":"رَسُول","r":"رسل","p":"nom","a":"wbw/063_005_007.mp3"},{"t":"ٱللَّهِ","en":"(of) Allah","tr":"l-lahi","l":"اللَّه","r":"أله","p":"nom propre","a":"wbw/063_005_008.mp3"},{"t":"لَوَّوْا۟","en":"They turn aside","tr":"lawwaw","l":"لَوَّ","r":"لوي","p":"verbe","a":"wbw/063_005_009.mp3"},{"t":"رُءُوسَهُمْ","en":"their heads","tr":"ruūsahum","l":"رَأْس","r":"رأس","p":"particule","a":"wbw/063_005_010.mp3"},{"t":"وَرَأَيْتَهُمْ","en":"and you see them","tr":"wara-aytahum","l":"رَأَى","r":"رأي","p":"verbe","a":"wbw/063_005_011.mp3"},{"t":"يَصُدُّونَ","en":"turning away","tr":"yaṣuddūna","l":"صَدَّ","r":"صدد","p":"verbe","a":"wbw/063_005_012.mp3"},{"t":"وَهُم","en":"while they","tr":"wahum","l":"وَهُم","r":null,"p":"pronom","a":"wbw/063_005_013.mp3"},{"t":"مُّسْتَكْبِرُونَ","en":"(are) arrogant","tr":"mus'takbirūna","l":"مُسْتَكْبِر","r":"كبر","p":"nom","a":"wbw/0