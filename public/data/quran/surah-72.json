ما","r":null,"p":"préposition","a":"wbw/072_007_003.mp3"},{"t":"ظَنَنتُمْ","en":"you thought","tr":"ẓanantum","l":"ظَنَّ","r":"ظنن","p":"verbe","a":"wbw/072_007_004.mp3"},{"t":"أَن","en":"that","tr":"an","l":"أَن","r":null,"p":"préposition","a":"wbw/072_007_005.mp3"},{"t":"لَّن","en":"never","tr":"lan","l":"لَن","r":null,"p":"négation","a":"wbw/072_007_006.mp3"},{"t":"يَبْعَثَ","en":"will raise","tr":"yabʿatha","l":"بَعَثَ","r":"بعث","p":"verbe","a":"wbw/072_007_007.mp3"},{"t":"ٱللَّهُ","en":"Allah","tr":"l-lahu","l":"اللَّه","r":"أله","p":"nom propre","a":"wbw/072_007_008.mp3"},{"t":"أَحَدًۭا","en":"anyone","tr":"aḥadan","l":"أَحَد","r":"أحد","p":"particule","a":"wbw/072_007_009.mp3"}]},{"n":8,"k":"72:8","fr":"Nous avions frôlé le ciel et Nous l’avions trouvé plein d’une forte garde et de bolides.","audio":"Alafasy/mp3/072008.mp3","w":[{"t":"وَأَنَّا","en":"And that we","tr":"wa-annā","l":"أَنّ","r":null,"p":"particule","a":"wbw/072_008_001.mp3"},{"t":"لَمَسْنَا","en":"sought to touch","tr":"lamasnā","l":"لَمَسُ","r":"لمس","p":"verbe","a":"wbw/072_008_002.mp3"},{"t":"ٱلسَّمَآءَ","en":"the heaven","tr":"l-samāa","l":"سَماء","r":"سمو","p":"particule","a":"wbw/072_008_003.mp3"},{"t":"فَوَجَدْنَـٰهَا","en":"but we found it","tr":"fawajadnāhā","l":"وَجَدَ","r":"وجد","p":"verbe","a":"wbw/072_008_004.mp3"},{"t":"مُلِئَتْ","en":"filled (with)","tr":"muli-at","l":"مُلِئَتْ","r":"ملأ","p":"verbe","a":"wbw/072_008_005.mp3"},{"t":"حَرَسًۭا","en":"guards","tr":"ḥarasan","l":"حَرَس","r":"حرس","p":"particule","a":"wbw/072_008_006.mp3"},{"t":"شَدِيدًۭا","en":"severe","tr":"shadīdan","l":"شَدِيد","r":"شدد","p":"particule","a":"wbw/072_008_007.mp3"},{"t":"وَشُهُبًۭا","en":"and flaming fires","tr":"washuhuban","l":"شُهُب","r":"شهب","p":"particule","a":"wbw/072_008_008.mp3"}]},{"n":9,"k":"72:9","fr":"Nous y prenions place pour écouter. Mais quiconque prête l’oreille maintenant, trouve contre lui un bolide aux aguets.","audio":"Alafasy/mp3/072009.mp3","w":[{"t":"وَأَنَّا","en":"And th