s.","audio":"Alafasy/mp3/049011.mp3","w":[{"t":"يَـٰٓأَيُّهَا","en":"O you who believe","tr":"yāayyuhā","l":"أَيّ","r":"أيي","p":"particule","a":"wbw/049_011_001.mp3"},{"t":"ٱلَّذِينَ","en":"O you who believe","tr":"alladhīna","l":"الَّذِي","r":null,"p":"relatif","a":"wbw/049_011_002.mp3"},{"t":"ءَامَنُوا۟","en":"O you who believe","tr":"āmanū","l":"آمَنَ","r":"أمن","p":"verbe","a":"wbw/049_011_003.mp3"},{"t":"لَا","en":"(Let) not","tr":"lā","l":"لا","r":null,"p":"préposition","a":"wbw/049_011_004.mp3"},{"t":"يَسْخَرْ","en":"ridicule","tr":"yaskhar","l":"سَخِرَ","r":"سخر","p":"verbe","a":"wbw/049_011_005.mp3"},{"t":"قَوْمٌۭ","en":"a people","tr":"qawmun","l":"قَوْم","r":"قوم","p":"nom","a":"wbw/049_011_006.mp3"},{"t":"مِّن","en":"[of]","tr":"min","l":"مِن","r":null,"p":"préposition","a":"wbw/049_011_007.mp3"},{"t":"قَوْمٍ","en":"(another) people","tr":"qawmin","l":"قَوْم","r":"قوم","p":"nom","a":"wbw/049_011_008.mp3"},{"t":"عَسَىٰٓ","en":"perhaps","tr":"ʿasā","l":"عَسَى","r":"عسي","p":"verbe","a":"wbw/049_011_009.mp3"},{"t":"أَن","en":"that","tr":"an","l":"أَن","r":null,"p":"préposition","a":"wbw/049_011_010.mp3"},{"t":"يَكُونُوا۟","en":"they may be","tr":"yakūnū","l":"كانَ","r":"كون","p":"verbe","a":"wbw/049_011_011.mp3"},{"t":"خَيْرًۭا","en":"better","tr":"khayran","l":"خَيْر","r":"خير","p":"particule","a":"wbw/049_011_012.mp3"},{"t":"مِّنْهُمْ","en":"than them","tr":"min'hum","l":"مِن","r":null,"p":"préposition","a":"wbw/049_011_013.mp3"},{"t":"وَلَا","en":"and (let) not","tr":"walā","l":"لا","r":null,"p":"préposition","a":"wbw/049_011_014.mp3"},{"t":"نِسَآءٌۭ","en":"women","tr":"nisāon","l":"نِساء","r":"نسو","p":"nom","a":"wbw/049_011_015.mp3"},{"t":"مِّن","en":"[of]","tr":"min","l":"مِن","r":null,"p":"préposition","a":"wbw/049_011_016.mp3"},{"t":"نِّسَآءٍ","en":"(other) women","tr":"nisāin","l":"نِساء","r":"نسو","p":"nom","a":"wbw/049_011_017.mp3"},{"t":"عَسَىٰٓ","en":"perhaps","tr":"ʿasā","l":"عَسَى","r":"عسي","p":"verbe","a":"wbw/049_011_018.mp3"},{"t":"أَن